<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lumina_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg_obsidian">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/directories_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/lumina_bottom_dock"
        android:layout_alignParentTop="true">

        <org.fossify.commons.views.MySearchMenu
            android:id="@+id/main_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RelativeLayout
            android:id="@+id/directories_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Lumina Editorial Brand Header & Quick Filter Chips -->
            <LinearLayout
                android:id="@+id/lumina_header_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/lumina_header_logo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_lumina_brand_mark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lumina_header_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.01"
                            android:text="@string/app_name"
                            android:textColor="@color/lumina_text_primary"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lumina_tagline"
                            android:textColor="@color/lumina_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/lumina_filter_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/lumina_chip_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="16dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="7dp"
                            android:text="@string/lumina_chip_all"
                            android:textColor="@color/lumina_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_filter_photos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/lumina_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="16dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="7dp"
                            android:text="@string/lumina_chip_photos"
                            android:textColor="@color/lumina_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_filter_videos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/lumina_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="16dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="7dp"
                            android:text="@string/lumina_chip_videos"
                            android:textColor="@color/lumina_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_filter_gifs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/lumina_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="16dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="7dp"
                            android:text="@string/lumina_chip_gifs"
                            android:textColor="@color/lumina_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/directories_switch_searching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lumina_header_strip"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:padding="@dimen/activity_margin"
                android:text="@string/switch_to_file_search"
                android:visibility="gone" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/directories_empty_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/directories_switch_searching"
                android:alpha="0.8"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:text="@string/no_media_with_filters"
                android:textSize="@dimen/bigger_text_size"
                android:textStyle="italic"
                android:visibility="gone" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/directories_empty_placeholder_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/directories_empty_placeholder"
                android:layout_centerHorizontal="true"
                android:background="@drawable/ripple_all_corners"
                android:padding="@dimen/activity_margin"
                android:text="@string/change_filters_underlined"
                android:textSize="@dimen/bigger_text_size"
                android:visibility="gone" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/directories_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/directories_switch_searching">

                <com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller
                    android:id="@+id/directories_fastscroller"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:supportSwipeToRefresh="true">

                    <org.fossify.commons.views.MyRecyclerView
                        android:id="@+id/directories_grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:layoutAnimation="@anim/layout_animation"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="12dp"
                        android:scrollbars="none"
                        app:layoutManager="org.fossify.commons.views.MyGridLayoutManager"
                        app:spanCount="@integer/directory_columns_vertical_scroll" />

                </com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Bottom Dock: AdMob Adaptive Banner + Lumina Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/lumina_bottom_dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/lumina_nav_bg"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/ad_banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/lumina_bg_obsidian"
            android:gravity="center"
            android:minHeight="0dp" />

        <LinearLayout
            android:id="@+id/lumina_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/lumina_bottom_nav_bg"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/nav_tab_albums"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_albums"
                    android:layout_width="48dp"
                    android:layout_height="28dp"
                    android:background="@drawable/lumina_bottom_nav_pill"
                    android:contentDescription="@string/lumina_nav_albums"
                    android:padding="4dp"
                    android:src="@drawable/ic_folders_vector"
                    app:tint="@color/lumina_accent_lavender" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/lumina_nav_albums"
                    android:textColor="@color/lumina_accent_lavender"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tab_all_media"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_all"
                    android:layout_width="48dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/lumina_nav_all"
                    android:padding="4dp"
                    android:src="@drawable/ic_files_vector"
                    app:tint="@color/lumina_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lumina_nav_all"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tab_favorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_favorites"
                    android:layout_width="48dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/lumina_nav_favorites"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_vector"
                    app:tint="@color/lumina_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lumina_nav_favorites"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_icon_settings"
                    android:layout_width="48dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/lumina_nav_settings"
                    android:padding="4dp"
                    android:src="@drawable/ic_settings_cog_vector"
                    app:tint="@color/lumina_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lumina_nav_settings"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
